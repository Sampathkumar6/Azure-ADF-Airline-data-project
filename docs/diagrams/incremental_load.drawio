<mxfile host="app.diagrams.net">
<diagram name="incremental_load" id="incremental_load">
<mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="560" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Incremental ingestion from Azure SQL DB using a watermark" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="6" width="1560" height="36" as="geometry"/></mxCell>
<mxCell id="jold" value="monitor/lastload.json&lt;br&gt;previous watermark" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8dcf3;strokeColor=#7e57a8;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="lk1" value="Lookup: Lastload&lt;br&gt;reads lastload from&lt;br&gt;monitor/lastload.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0ea;strokeColor=#2a8f7c;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="lk2" value="Lookup: latestload&lt;br&gt;select max(booking_date)&lt;br&gt;from dbo.FactBookings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0ea;strokeColor=#2a8f7c;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="db" value="Azure SQL Database&lt;br&gt;FactBookings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9f6;strokeColor=#4a7fb0;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="60" width="340" height="80" as="geometry"/></mxCell>
<mxCell id="copy" value="Copy_sqldata&lt;br&gt;select * from dbo.FactBookings&lt;br&gt;where booking_date is after lastload&lt;br&gt;and up to latestload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0ea;strokeColor=#2a8f7c;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="230" width="340" height="120" as="geometry"/></mxCell>
<mxCell id="br" value="bronze/sql&lt;br&gt;only the new rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4dcc3;strokeColor=#b8742f;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="420" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="wm" value="Copy: Watermark&lt;br&gt;adds a lastload column holding latestload&lt;br&gt;and overwrites the JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0ea;strokeColor=#2a8f7c;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="230" width="320" height="120" as="geometry"/></mxCell>
<mxCell id="jnew" value="monitor/lastload.json&lt;br&gt;new watermark = latestload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8dcf3;strokeColor=#7e57a8;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1280" y="245" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="note" value="Each run copies only rows dated after the previous watermark and up to the current max(booking_date).&lt;br&gt;The watermark then moves forward to that date, so older rows are not copied again." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#c8a951;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="420" width="640" height="80" as="geometry"/></mxCell>
<mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="jold" target="lk1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="lk1" target="copy"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="lk2" target="copy"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="db" target="copy"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="copy" target="br"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="on success" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="copy" target="wm"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="next run&#x27;s lastload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="wm" target="jnew"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>